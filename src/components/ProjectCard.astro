---
import type { ProjectItemData } from '../data/content';
import StatusBadge from './StatusBadge.astro';

interface Props {
  ptProject: ProjectItemData;
  enProject: ProjectItemData;
}

const { ptProject, enProject } = Astro.props;
---

<div
  id={`project-${ptProject.id}`}
  class:list={[
    'pt-8 pb-10 border-t border-[#e5e5dc] dark:border-[#2c2c28] first:border-t-0 first:pt-0',
  ]}
>
  <!-- Card Header: Title, Tags & Prominent Status Badge -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
    <div class="space-y-1">
      <div class="flex items-center gap-2 flex-wrap">
        <h4 class="text-xl sm:text-2xl font-semibold tracking-tight text-stone-900 dark:text-white">
          {ptProject.title}
        </h4>
        {ptProject.isFlagship && (
          <span class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-amber-700 dark:text-amber-400">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-600 dark:bg-amber-400"></span>
            <span class="lang-pt">Projeto Principal</span>
            <span class="lang-en">Flagship</span>
          </span>
        )}
        {ptProject.isComplementary && (
          <span class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-stone-500 dark:text-stone-400">
            <span class="w-1.5 h-1.5 rounded-full bg-stone-400 dark:bg-stone-500"></span>
            <span class="lang-pt">Prática Fundamental</span>
            <span class="lang-en">Foundational Practice</span>
          </span>
        )}
      </div>

      <!-- One-line Pitch -->
      <p class="text-sm font-normal text-stone-700 dark:text-stone-300 leading-relaxed max-w-prose">
        <span class="lang-pt">{ptProject.pitch}</span>
        <span class="lang-en">{enProject.pitch}</span>
      </p>
    </div>

    <!-- Mandatory Prominent Status Badge -->
    <div class="flex-shrink-0 self-start sm:self-center">
      <StatusBadge
        status={ptProject.status.code || ptProject.status.label}
        labelPt={ptProject.status.label}
        labelEn={enProject.status.label}
      />
    </div>
  </div>

  <!-- Real Stakeholder Context Callout (Flattened left-accent, no nested card) -->
  {ptProject.stakeholderContext && (
    <div class="my-3 pl-3.5 py-1 border-l-2 border-amber-600/70 dark:border-amber-400/70 text-xs text-stone-700 dark:text-stone-300 max-w-prose">
      <div class="flex items-center gap-1.5 font-medium font-mono uppercase text-xs text-amber-800 dark:text-amber-400 mb-1">
        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="lang-pt">Contexto do Projeto:</span>
        <span class="lang-en">Project Context:</span>
      </div>
      <p class="lang-pt leading-relaxed font-normal text-stone-600 dark:text-stone-400">{ptProject.stakeholderContext}</p>
      <p class="lang-en leading-relaxed font-normal text-stone-600 dark:text-stone-400">{enProject.stakeholderContext}</p>
    </div>
  )}

  <!-- 2-4 Sentence Description -->
  <p class="text-sm font-normal text-stone-600 dark:text-stone-400 mb-5 leading-relaxed max-w-prose">
    <span class="lang-pt">{ptProject.description}</span>
    <span class="lang-en">{enProject.description}</span>
  </p>

  <!-- Dedicated Subsection: Architectural Decisions & Trade-offs (Flattened Elegant Left Accent) -->
  <div class="my-5 pl-4 py-1 border-l-2 border-amber-600 dark:border-amber-500 space-y-2.5 max-w-prose">
    <div class="flex items-center gap-2">
      <h5 class="text-xs font-mono font-semibold uppercase tracking-wider text-amber-800 dark:text-amber-400">
        <span class="lang-pt">Decisão Arquitetural:</span>
        <span class="lang-en">Architectural Decision:</span>
      </h5>
      <span class="text-xs font-medium text-stone-900 dark:text-stone-100">
        <span class="lang-pt">{ptProject.architecturalDecisions.title}</span>
        <span class="lang-en">{enProject.architecturalDecisions.title}</span>
      </span>
    </div>

    <p class="text-xs font-normal text-stone-600 dark:text-stone-300 leading-relaxed max-w-prose">
      <span class="lang-pt">{ptProject.architecturalDecisions.details}</span>
      <span class="lang-en">{enProject.architecturalDecisions.details}</span>
    </p>

    <div class="text-xs pt-1 text-stone-700 dark:text-stone-300 max-w-prose">
      <span class="font-medium font-mono text-xs text-stone-900 dark:text-stone-100 mr-1.5">
        <span class="lang-pt">Trade-off / Análise:</span>
        <span class="lang-en">Trade-off / Analysis:</span>
      </span>
      <span class="lang-pt font-normal text-stone-600 dark:text-stone-400 leading-relaxed">{ptProject.architecturalDecisions.tradeoffs}</span>
      <span class="lang-en font-normal text-stone-600 dark:text-stone-400 leading-relaxed">{enProject.architecturalDecisions.tradeoffs}</span>
    </div>
  </div>

  <!-- Tech Stack (Clean typographic layout, no nested card boxes) -->
  <div class="mb-5 max-w-prose">
    <span class="text-xs font-mono font-medium uppercase tracking-wider text-stone-500 dark:text-stone-400 block mb-2">
      <span class="lang-pt">Tecnologias Utilizadas</span>
      <span class="lang-en">Technologies</span>
    </span>
    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs font-mono text-stone-700 dark:text-stone-300">
      {ptProject.stack.map((tech, idx) => (
        <span class="inline-flex items-center gap-2">
          {idx > 0 && <span class="text-stone-300 dark:text-stone-700 select-none">•</span>}
          <span>{tech}</span>
        </span>
      ))}
    </div>
  </div>

  <!-- Transparent Links & Deployment Status Footer -->
  <div class="pt-4 border-t border-stone-100 dark:border-[#282824] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
    <!-- Honest Deployment Note -->
    <div class="flex items-center gap-2 text-stone-500 dark:text-stone-400">
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span class="lang-pt">{ptProject.links.deployStatusNote}</span>
      <span class="lang-en">{enProject.links.deployStatusNote}</span>
    </div>

    <!-- Action Links (only rendered if they genuinely exist) -->
    <div class="flex items-center gap-3">
      {ptProject.links.repo ? (
        <a
          href={ptProject.links.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md font-mono font-semibold bg-stone-900 text-white dark:bg-[#252522] dark:text-stone-200 hover:bg-stone-800 dark:hover:bg-[#2d2d2a] transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          <span>Repositório / Repo</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      ) : (
        <span class="inline-flex items-center gap-1 text-stone-400 dark:text-stone-500 font-mono text-xs italic">
          <span class="lang-pt">({ptProject.links.repoNote || 'Código local / Repo pendente'})</span>
          <span class="lang-en">({enProject.links.repoNote || 'Local code / Repo pending'})</span>
        </span>
      )}
    </div>
  </div>
</div>
