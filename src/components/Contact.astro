---
import { portfolioContent } from '../data/content';

const pt = portfolioContent['pt-BR'].contact;
const en = portfolioContent['en'].contact;
const metaPt = portfolioContent['pt-BR'].meta;
---

<section id="contact" class="py-12 sm:py-20">
  <div class="space-y-3 mb-8">
    <div class="flex items-center gap-2">
      <h2 class="text-xs font-mono uppercase tracking-widest text-amber-700 dark:text-amber-400">
        <span class="lang-pt">{pt.sectionTag}</span>
        <span class="lang-en">{en.sectionTag}</span>
      </h2>
    </div>

    <h3 class="text-2xl sm:text-3xl font-bold font-display tracking-tight text-slate-900 dark:text-white">
      <span class="lang-pt">{pt.sectionTitle}</span>
      <span class="lang-en">{en.sectionTitle}</span>
    </h3>

    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl">
      <span class="lang-pt">{pt.sectionSubtitle}</span>
      <span class="lang-en">{en.sectionSubtitle}</span>
    </p>
  </div>

  <div class="p-6 sm:p-8 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 shadow-sm space-y-6">
    <!-- Opportunity Headline Callout (Flattened left-accent, no nested card, no pulsing dot) -->
    <div class="pl-4 py-1 border-l-2 border-amber-600 dark:border-amber-400">
      <div class="flex items-center gap-2 text-amber-800 dark:text-amber-400 font-mono text-xs font-bold uppercase tracking-wider mb-1">
        <span class="w-2 h-2 rounded-full bg-emerald-600 dark:bg-emerald-500"></span>
        <span class="lang-pt">Foco Principal</span>
        <span class="lang-en">Current Focus</span>
      </div>
      <p class="text-sm sm:text-base font-semibold text-slate-900 dark:text-white">
        <span class="lang-pt">{pt.opportunityHeadline}</span>
        <span class="lang-en">{en.opportunityHeadline}</span>
      </p>
    </div>

    <!-- Message Body -->
    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
      <span class="lang-pt">{pt.message}</span>
      <span class="lang-en">{en.message}</span>
    </p>

    <!-- Logistics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">
          <span class="lang-pt">{pt.locationLabel}</span>
          <span class="lang-en">{en.locationLabel}</span>
        </span>
        <span class="font-medium text-slate-800 dark:text-slate-200">
          <span class="lang-pt">{pt.locationValue}</span>
          <span class="lang-en">{en.locationValue}</span>
        </span>
      </div>

      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">
          <span class="lang-pt">{pt.statusLabel}</span>
          <span class="lang-en">{en.statusLabel}</span>
        </span>
        <span class="font-medium text-slate-800 dark:text-slate-200">
          <span class="lang-pt">{pt.statusValue}</span>
          <span class="lang-en">{en.statusValue}</span>
        </span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center gap-3">
      <!-- Direct Mailto CTA -->
      <a
        href={`mailto:${metaPt.email}`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-amber-700 hover:bg-amber-800 dark:bg-amber-500 dark:text-amber-950 dark:hover:bg-amber-400 text-white font-semibold text-sm shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <span class="lang-pt">{pt.emailActionLabel} ({metaPt.email})</span>
        <span class="lang-en">{en.emailActionLabel} ({metaPt.email})</span>
      </a>

      <!-- View Resume PDF -->
      <a
        href={metaPt.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 font-semibold text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span class="lang-pt">{pt.viewResumeLabel}</span>
        <span class="lang-en">{en.viewResumeLabel}</span>
      </a>

      <!-- GitHub Link -->
      <a
        href={metaPt.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 font-semibold text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>GitHub</span>
      </a>

      <!-- LinkedIn Link -->
      <a
        href={metaPt.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 font-semibold text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"></path>
        </svg>
        <span>LinkedIn</span>
      </a>
    </div>
  </div>
</section>
