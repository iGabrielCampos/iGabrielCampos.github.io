---
import { portfolioContent } from '../data/content';

const pt = portfolioContent['pt-BR'].journal;
const en = portfolioContent['en'].journal;
---

<section id="journal" class="py-12 sm:py-16 border-b border-slate-200 dark:border-slate-800">
  <div class="space-y-3 mb-8">
    <div class="flex items-center gap-2">
      <span class="text-xs font-mono font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">
        04.
      </span>
      <h2 class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400">
        <span class="lang-pt">{pt.sectionTag}</span>
        <span class="lang-en">{en.sectionTag}</span>
      </h2>
    </div>

    <h3 class="text-2xl sm:text-3xl font-bold font-mono tracking-tight text-slate-900 dark:text-white">
      <span class="lang-pt">{pt.sectionTitle}</span>
      <span class="lang-en">{en.sectionTitle}</span>
    </h3>

    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl">
      <span class="lang-pt">{pt.sectionSubtitle}</span>
      <span class="lang-en">{en.sectionSubtitle}</span>
    </p>
  </div>

  <div class="space-y-6">
    {pt.items.map((ptPost, index) => {
      const enPost = en.items[index] || ptPost;
      return (
        <article
          id={`post-${ptPost.slug}`}
          class="p-6 sm:p-7 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 shadow-sm"
        >
          <!-- Post Metadata & Tags -->
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-3 text-xs font-mono text-slate-500 dark:text-slate-400">
              <span class="lang-pt">{ptPost.date}</span>
              <span class="lang-en">{enPost.date}</span>
              <span>•</span>
              <span class="lang-pt">{ptPost.readTime}</span>
              <span class="lang-en">{enPost.readTime}</span>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5">
              {ptPost.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Post Title -->
          <h4 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-2">
            <span class="lang-pt">{ptPost.title}</span>
            <span class="lang-en">{enPost.title}</span>
          </h4>

          <!-- Summary -->
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-4 leading-relaxed">
            <span class="lang-pt">{ptPost.summary}</span>
            <span class="lang-en">{enPost.summary}</span>
          </p>

          <!-- Expandable Full Article Body -->
          <details class="group pt-2 border-t border-slate-100 dark:border-slate-800">
            <summary class="cursor-pointer font-mono text-xs font-semibold text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 inline-flex items-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-sky-500 rounded py-1">
              <span class="group-open:hidden">
                <span class="lang-pt">↓ {pt.readMoreLabel}</span>
                <span class="lang-en">↓ {en.readMoreLabel}</span>
              </span>
              <span class="hidden group-open:inline">
                <span class="lang-pt">↑ Recolher artigo</span>
                <span class="lang-en">↑ Collapse article</span>
              </span>
            </summary>

            <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800/80 prose prose-slate dark:prose-invert max-w-none text-xs sm:text-sm leading-relaxed whitespace-pre-line text-slate-700 dark:text-slate-300">
              <div class="lang-pt">{ptPost.content}</div>
              <div class="lang-en">{enPost.content}</div>
            </div>
          </details>
        </article>
      );
    })}
  </div>
</section>
