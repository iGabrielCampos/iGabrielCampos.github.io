---
import { portfolioContent } from '../data/content';

const pt = portfolioContent['pt-BR'].journal;
const en = portfolioContent['en'].journal;

function renderMarkdown(md: string): string {
  if (!md) return '';
  let html = md.replace(/```([a-z]*)\n([\s\S]*?)```/g, (_, _lang, code) => {
    return `<pre class="my-3 p-3.5 rounded-lg bg-slate-900 text-slate-100 font-mono text-xs overflow-x-auto border border-slate-800"><code>${code.trim()}</code></pre>`;
  });
  html = html.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-slate-900 dark:text-white">$1</strong>');
  html = html.replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-[#161614] font-mono text-xs text-sky-800 dark:text-amber-300 border border-slate-200/80 dark:border-[#282824]">$1</code>');
  const blocks = html.split(/\n\n+/).map(p => {
    const trimmed = p.trim();
    if (trimmed.startsWith('<pre')) return trimmed;
    if (trimmed.includes('\n- ') || trimmed.startsWith('- ')) {
      const items = trimmed.split(/\n?- /).filter(Boolean);
      return `<ul class="list-disc list-inside space-y-1.5 my-2 pl-1">${items.map(i => `<li>${i.trim()}</li>`).join('')}</ul>`;
    }
    return `<p class="mb-3 leading-relaxed">${trimmed}</p>`;
  });
  return blocks.join('');
}
---

<section id="journal" class="py-12 sm:py-16 bg-slate-100/60 dark:bg-[#1a1a18]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-3 mb-8">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">
        <span class="lang-pt">{pt.sectionTitle}</span>
        <span class="lang-en">{en.sectionTitle}</span>
      </h2>

      <p class="text-sm sm:text-base font-normal text-slate-600 dark:text-stone-400 max-w-prose leading-relaxed">
        <span class="lang-pt">{pt.sectionSubtitle}</span>
        <span class="lang-en">{en.sectionSubtitle}</span>
      </p>
    </div>

    <div class="mt-8 space-y-6">
      {pt.items.map((ptPost, index) => {
        const enPost = en.items[index] || ptPost;
        return (
          <div
            class="p-6 sm:p-7 rounded-xl bg-white dark:bg-[#1c1c1a] border border-slate-200/90 dark:border-[#282824] shadow-xs hover:border-slate-300 dark:hover:border-[#3a3a34] transition-colors"
            id={ptPost.slug}
          >
            <!-- Post Header -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-3 text-xs text-slate-500 dark:text-stone-400">
              <div class="flex items-center gap-3 font-mono">
                <time datetime={ptPost.date}>{ptPost.date}</time>
                <span>•</span>
                <span class="lang-pt">{ptPost.readTime}</span>
                <span class="lang-en">{enPost.readTime}</span>
              </div>

              <!-- Tags -->
              <div class="flex flex-wrap items-center gap-1.5 font-mono text-xs">
                {ptPost.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-[#161614] text-slate-700 dark:text-stone-300 border border-slate-200/80 dark:border-[#282824]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Post Title -->
            <h3 class="text-lg sm:text-xl font-semibold text-slate-900 dark:text-white mb-2">
              <span class="lang-pt">{ptPost.title}</span>
              <span class="lang-en">{enPost.title}</span>
            </h3>

            <!-- Summary -->
            <p class="text-sm font-normal text-slate-600 dark:text-stone-400 mb-4 leading-relaxed max-w-prose">
              <span class="lang-pt">{ptPost.summary}</span>
              <span class="lang-en">{enPost.summary}</span>
            </p>

            <!-- Expandable Full Article Body -->
            <details class="group pt-3 border-t border-slate-100 dark:border-[#282824]">
              <summary class="cursor-pointer font-mono text-xs font-semibold text-sky-700 dark:text-amber-400 hover:text-sky-800 dark:hover:text-amber-300 inline-flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:focus-visible:ring-amber-500 rounded py-2 min-h-[44px]">
                <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M19 9l-7 7-7-7"></path>
                </svg>
                <span class="group-open:hidden">
                  <span class="lang-pt">{pt.readMoreLabel}</span>
                  <span class="lang-en">{en.readMoreLabel}</span>
                </span>
                <span class="hidden group-open:inline">
                  <span class="lang-pt">Recolher artigo</span>
                  <span class="lang-en">Collapse article</span>
                </span>
              </summary>

              <div class="mt-4 pt-4 border-t border-slate-100 dark:border-[#282824] max-w-prose text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-stone-300">
                <div class="lang-pt" set:html={renderMarkdown(ptPost.content)} />
                <div class="lang-en" set:html={renderMarkdown(enPost.content)} />
              </div>
            </details>
          </div>
        );
      })}
    </div>
  </div>
</section>
