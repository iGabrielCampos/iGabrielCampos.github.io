---
import { portfolioContent } from '../data/content';
import ProjectCard from './ProjectCard.astro';

const pt = portfolioContent['pt-BR'].projects;
const en = portfolioContent['en'].projects;

// Ensure strict order 1 -> 4
const ptSorted = [...pt.items].sort((a, b) => a.order - b.order);
const enSorted = [...en.items].sort((a, b) => a.order - b.order);
---

<section id="projects" class="py-12 sm:py-16 border-b border-slate-200 dark:border-slate-800">
  <!-- Section Heading -->
  <div class="space-y-3 mb-8">
    <div class="flex items-center gap-2">
      <h2 class="text-xs font-mono uppercase tracking-widest text-amber-700 dark:text-amber-400">
        <span class="lang-pt">{pt.sectionTag}</span>
        <span class="lang-en">{en.sectionTag}</span>
      </h2>
    </div>

    <h3 class="text-2xl sm:text-3xl font-bold font-display tracking-tight text-slate-900 dark:text-white">
      <span class="lang-pt">{pt.sectionTitle}</span>
      <span class="lang-en">{en.sectionTitle}</span>
    </h3>

    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl">
      <span class="lang-pt">{pt.sectionSubtitle}</span>
      <span class="lang-en">{en.sectionSubtitle}</span>
    </p>

    <!-- Honesty Banner / Compromisso de Transparência (Flattened left-accent) -->
    <div class="mt-4 pl-4 py-1.5 border-l-2 border-amber-600 dark:border-amber-500 text-xs text-slate-700 dark:text-slate-300 flex items-start gap-2.5">
      <svg class="w-4 h-4 text-amber-700 dark:text-amber-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <div>
        <span class="font-mono font-bold block mb-0.5 text-slate-900 dark:text-white">
          <span class="lang-pt">{pt.honestyBanner.title}</span>
          <span class="lang-en">{en.honestyBanner.title}</span>
        </span>
        <span class="lang-pt leading-relaxed text-slate-600 dark:text-slate-400">{pt.honestyBanner.message}</span>
        <span class="lang-en leading-relaxed text-slate-600 dark:text-slate-400">{en.honestyBanner.message}</span>
      </div>
    </div>
  </div>

  <!-- Projects List (Strict Order) -->
  <div class="space-y-6 sm:space-y-8">
    {ptSorted.map((ptProject, index) => {
      const enProject = enSorted[index] || ptProject;
      return <ProjectCard ptProject={ptProject} enProject={enProject} />;
    })}
  </div>
</section>
