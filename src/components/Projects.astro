---
import { portfolioContent } from '../data/content';
import ProjectCard from './ProjectCard.astro';

const pt = portfolioContent['pt-BR'].projects;
const en = portfolioContent['en'].projects;

// Ensure strict order 1 -> 4
const ptSorted = [...pt.items].sort((a, b) => a.order - b.order);
const enSorted = [...en.items].sort((a, b) => a.order - b.order);
---

<section id="projects" class="py-12 sm:py-16 bg-slate-50 dark:bg-[#141413] border-b border-slate-200/80 dark:border-[#2c2c28]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="space-y-3 mb-8">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">
        <span class="lang-pt">{pt.sectionTitle}</span>
        <span class="lang-en">{en.sectionTitle}</span>
      </h2>

      <p class="text-sm sm:text-base font-normal text-slate-600 dark:text-stone-400 max-w-prose leading-relaxed">
        <span class="lang-pt">{pt.sectionSubtitle}</span>
        <span class="lang-en">{en.sectionSubtitle}</span>
      </p>

      <!-- Honesty Banner / Compromisso de Transparência -->
      <div class="mt-4 p-4 rounded-xl bg-sky-50/70 dark:bg-[#181816] border border-sky-200 dark:border-[#282824] text-xs text-slate-700 dark:text-stone-300 flex items-start gap-3 max-w-prose shadow-xs">
        <svg class="w-4 h-4 text-sky-700 dark:text-amber-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
        <div>
          <span class="font-mono font-semibold block mb-0.5 text-slate-900 dark:text-white">
            <span class="lang-pt">{pt.honestyBanner.title}</span>
            <span class="lang-en">{en.honestyBanner.title}</span>
          </span>
          <span class="lang-pt leading-relaxed text-slate-600 dark:text-stone-400">{pt.honestyBanner.message}</span>
          <span class="lang-en leading-relaxed text-slate-600 dark:text-stone-400">{en.honestyBanner.message}</span>
        </div>
      </div>
    </div>

    <!-- Projects List (Strict Order) -->
    <div class="mt-8 space-y-6">
      {ptSorted.map((ptProject, index) => {
        const enProject = enSorted[index] || ptProject;
        return <ProjectCard ptProject={ptProject} enProject={enProject} />;
      })}
    </div>
  </div>
</section>
