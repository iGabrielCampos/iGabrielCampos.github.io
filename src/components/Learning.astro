---
import { portfolioContent } from '../data/content';

const pt = portfolioContent['pt-BR'].learning;
const en = portfolioContent['en'].learning;
---

<section id="learning" class="py-12 sm:py-16 border-b border-slate-200 dark:border-slate-800">
  <div class="space-y-3 mb-8">
    <div class="flex items-center gap-2">
      <h2 class="text-xs font-mono uppercase tracking-widest text-amber-700 dark:text-amber-400">
        <span class="lang-pt">{pt.sectionTag}</span>
        <span class="lang-en">{en.sectionTag}</span>
      </h2>
    </div>

    <h3 class="text-2xl sm:text-3xl font-bold font-display tracking-tight text-slate-900 dark:text-white">
      <span class="lang-pt">{pt.sectionTitle}</span>
      <span class="lang-en">{en.sectionTitle}</span>
    </h3>

    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl">
      <span class="lang-pt">{pt.sectionSubtitle}</span>
      <span class="lang-en">{en.sectionSubtitle}</span>
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
    {pt.items.map((ptItem, index) => {
      const enItem = en.items[index] || ptItem;
      return (
        <div class="p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 flex flex-col justify-between shadow-sm">
          <div>
            <!-- Category and Status -->
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-800 dark:text-amber-400">
                <span class="lang-pt">{ptItem.category}</span>
                <span class="lang-en">{enItem.category}</span>
              </span>
              <span class="px-2.5 py-1 rounded-full text-xs font-mono font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                <span class="lang-pt">{ptItem.status}</span>
                <span class="lang-en">{enItem.status}</span>
              </span>
            </div>

            <!-- Topic Title -->
            <h4 class="text-base font-bold font-display text-slate-900 dark:text-white mb-2">
              <span class="lang-pt">{ptItem.topic}</span>
              <span class="lang-en">{enItem.topic}</span>
            </h4>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-4 leading-relaxed">
              <span class="lang-pt">{ptItem.description}</span>
              <span class="lang-en">{enItem.description}</span>
            </p>
          </div>

          <!-- Focus Areas -->
          <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80">
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1.5">
              <span class="lang-pt">Tópicos em Foco</span>
              <span class="lang-en">Focus Areas</span>
            </span>
            <ul class="space-y-1 text-xs text-slate-700 dark:text-slate-300">
              {ptItem.focusAreas.map((area, areaIdx) => {
                const enArea = enItem.focusAreas[areaIdx] || area;
                return (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-600 dark:bg-amber-500 flex-shrink-0"></span>
                    <span class="lang-pt">{area}</span>
                    <span class="lang-en">{enArea}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      );
    })}
  </div>
</section>
