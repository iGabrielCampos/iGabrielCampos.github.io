---
import { portfolioContent } from '../data/content';

const pt = portfolioContent['pt-BR'];
const en = portfolioContent['en'];
---

<section id="hero" class="py-12 sm:py-20 border-b border-slate-200 dark:border-slate-800">
  <div class="space-y-6">
    <!-- Internship Availability Badge -->
    <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-300 dark:border-emerald-700/80 text-emerald-800 dark:text-emerald-300 text-xs font-mono font-semibold shadow-xs">
      <span class="inline-flex rounded-full h-2 w-2 bg-emerald-500" aria-hidden="true"></span>
      <span class="lang-pt">{pt.hero.statusBadge}</span>
      <span class="lang-en">{en.hero.statusBadge}</span>
    </div>

    <!-- Name and Terminal Motif -->
    <div>
      <p class="text-xs font-mono uppercase tracking-widest text-amber-700 dark:text-amber-400 mb-2">
        <span class="lang-pt">{pt.hero.greeting}</span>
        <span class="lang-en">{en.hero.greeting}</span>
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
        {pt.meta.name}
      </h1>
    </div>

    <!-- Main Headline and Subheadline -->
    <div class="space-y-3 max-w-3xl">
      <p class="text-lg sm:text-xl font-medium text-slate-800 dark:text-slate-200 leading-snug">
        <span class="lang-pt">{pt.hero.headline}</span>
        <span class="lang-en">{en.hero.headline}</span>
      </p>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
        <span class="lang-pt">{pt.hero.subheadline}</span>
        <span class="lang-en">{en.hero.subheadline}</span>
      </p>
    </div>

    <!-- CTAs and Direct Links -->
    <div class="pt-2 flex flex-wrap items-center gap-3 sm:gap-4">
      <a
        href={pt.hero.ctaPrimary.href}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-slate-900 text-white dark:bg-amber-500 dark:text-amber-950 font-semibold text-sm hover:bg-slate-800 dark:hover:bg-amber-400 shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500"
      >
        <span class="lang-pt">{pt.hero.ctaPrimary.label}</span>
        <span class="lang-en">{en.hero.ctaPrimary.label}</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>

      <!-- Resume PDF Button (High-value Recruiter Action) -->
      <a
        href={pt.meta.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 font-semibold text-sm hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500 shadow-sm"
        aria-label="Curriculum Vitae / Resume (PDF)"
      >
        <svg class="w-4 h-4 text-amber-700 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span class="lang-pt">Currículo (PDF)</span>
        <span class="lang-en">Resume (PDF)</span>
      </a>

      <a
        href={pt.hero.ctaSecondary.href}
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-transparent text-slate-600 dark:text-slate-400 font-semibold text-sm hover:text-slate-900 dark:hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500"
      >
        <span class="lang-pt">{pt.hero.ctaSecondary.label}</span>
        <span class="lang-en">{en.hero.ctaSecondary.label}</span>
      </a>

      <!-- Quick Social / Direct Icons -->
      <div class="flex items-center gap-2 pl-2 sm:border-l sm:border-slate-300 sm:dark:border-slate-700">
        <!-- GitHub -->
        <a
          href={pt.meta.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          aria-label="GitHub Profile"
          title="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href={pt.meta.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          aria-label="LinkedIn Profile"
          title="LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"></path>
          </svg>
        </a>

        <!-- Direct Email -->
        <a
          href={`mailto:${pt.meta.email}`}
          class="p-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          aria-label="Send Email"
          title={pt.meta.email}
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
