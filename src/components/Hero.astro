---
import { portfolioContent } from '../data/content';

const pt = portfolioContent['pt-BR'];
const en = portfolioContent['en'];
---

<section id="hero" class="py-12 sm:py-20 bg-slate-50 dark:bg-[#141413] border-b border-slate-200/80 dark:border-[#2c2c28]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    <!-- Internship Availability Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-[#1c1c1a] border border-slate-200 dark:border-[#2c2c28] text-slate-700 dark:text-stone-300 text-xs font-mono font-medium shadow-xs">
      <svg class="w-1.5 h-1.5 flex-shrink-0" viewBox="0 0 6 6" aria-hidden="true">
        <circle cx="3" cy="3" r="2.5" class="fill-emerald-500 dark:fill-emerald-400" />
      </svg>
      <span class="lang-pt">{pt.hero.statusBadge}</span>
      <span class="lang-en">{en.hero.statusBadge}</span>
    </div>

    <!-- Name and Terminal Motif -->
    <div>
      <p class="text-xs font-mono uppercase tracking-widest text-sky-700 dark:text-amber-400 mb-2">
        <span class="lang-pt">{pt.hero.greeting}</span>
        <span class="lang-en">{en.hero.greeting}</span>
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-slate-900 dark:text-white">
        {pt.meta.name}
      </h1>
    </div>

    <!-- Main Headline -->
    <div class="max-w-prose">
      <p class="text-lg sm:text-xl font-normal text-slate-700 dark:text-stone-200 leading-snug">
        <span class="lang-pt">{pt.hero.headline}</span>
        <span class="lang-en">{en.hero.headline}</span>
      </p>
    </div>

    <!-- CTAs and Direct Links -->
    <div class="pt-2 flex flex-wrap items-center gap-3 sm:gap-4">
      <a
        href={pt.hero.ctaPrimary.href}
        class="inline-flex items-center gap-2 px-5 py-2.5 min-h-[44px] rounded-lg bg-sky-700 text-white hover:bg-sky-800 dark:bg-amber-500 dark:text-amber-950 dark:hover:bg-amber-400 font-semibold text-sm shadow-xs transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:focus-visible:ring-amber-500"
      >
        <span class="lang-pt">{pt.hero.ctaPrimary.label}</span>
        <span class="lang-en">{en.hero.ctaPrimary.label}</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>

      <!-- Resume PDF Button - PT (shows when language is Portuguese) -->
      <a
        href={pt.meta.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="lang-pt inline-flex items-center gap-2 px-4 py-2.5 min-h-[44px] rounded-lg border border-slate-200 dark:border-[#2c2c28] bg-white dark:bg-[#1c1c1a] text-slate-800 dark:text-stone-200 font-semibold text-sm hover:bg-slate-100 dark:hover:bg-[#252522] hover:border-slate-300 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:focus-visible:ring-amber-500 shadow-xs"
        aria-label="Currículo (PDF)"
      >
        <svg class="w-4 h-4 text-sky-700 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span>Currículo (PDF)</span>
      </a>

      <!-- Resume PDF Button - EN (shows when language is English) -->
      <a
        href={en.meta.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="lang-en inline-flex items-center gap-2 px-4 py-2.5 min-h-[44px] rounded-lg border border-slate-200 dark:border-[#2c2c28] bg-white dark:bg-[#1c1c1a] text-slate-800 dark:text-stone-200 font-semibold text-sm hover:bg-slate-100 dark:hover:bg-[#252522] hover:border-slate-300 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:focus-visible:ring-amber-500 shadow-xs"
        aria-label="Resume (PDF)"
      >
        <svg class="w-4 h-4 text-sky-700 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span>Resume (PDF)</span>
      </a>

      <!-- Quick Social / Direct Icons -->
      <div class="flex items-center gap-1.5 pl-2 sm:border-l sm:border-slate-200 sm:dark:border-[#2c2c28]">
        <!-- GitHub -->
        <a
          href={pt.meta.github}
          target="_blank"
          rel="noopener noreferrer"
          class="w-11 h-11 inline-flex items-center justify-center rounded-lg text-slate-600 dark:text-stone-400 hover:text-slate-900 dark:hover:text-white hover:bg-white dark:hover:bg-[#1c1c1a] border border-transparent hover:border-slate-200 dark:hover:border-transparent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:focus-visible:ring-amber-500"
          aria-label="GitHub Profile (abre em nova aba)"
          title="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href={pt.meta.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="w-11 h-11 inline-flex items-center justify-center rounded-lg text-slate-600 dark:text-stone-400 hover:text-slate-900 dark:hover:text-white hover:bg-white dark:hover:bg-[#1c1c1a] border border-transparent hover:border-slate-200 dark:hover:border-transparent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:focus-visible:ring-amber-500"
          aria-label="LinkedIn Profile (abre em nova aba)"
          title="LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"></path>
          </svg>
        </a>

        <!-- Direct Email -->
        <a
          href={`mailto:${pt.meta.email}`}
          class="w-11 h-11 inline-flex items-center justify-center rounded-lg text-slate-600 dark:text-stone-400 hover:text-slate-900 dark:hover:text-white hover:bg-white dark:hover:bg-[#1c1c1a] border border-transparent hover:border-slate-200 dark:hover:border-transparent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:focus-visible:ring-amber-500"
          aria-label="Enviar Email"
          title={pt.meta.email}
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
