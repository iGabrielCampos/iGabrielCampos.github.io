---
import type { ProjectStatus, NormalizedStatus, StatusConfig } from '../types';

export type { ProjectStatus };

interface Props {
  status: string;
  class?: string;
  size?: 'sm' | 'md';
  labelPt?: string;
  labelEn?: string;
}

const {
  status,
  class: className = '',
  size = 'md',
  labelPt: customLabelPt,
  labelEn: customLabelEn,
} = Astro.props;

// Normalize status key handling English, Portuguese, codes, and variants
const normalizeStatus = (s: string): NormalizedStatus => {
  const normalized = (s || '').trim().toLowerCase();

  // Functional / Near-Complete
  if (
    normalized.includes('functional') ||
    normalized.includes('funcional') ||
    normalized.includes('near-complete') ||
    normalized.includes('concluded') ||
    normalized.includes('concluído')
  ) {
    return 'functional';
  }

  // In Development
  if (
    normalized.includes('development') ||
    normalized.includes('desenvolvimento')
  ) {
    return 'development';
  }

  // Planning / Modeling
  if (
    normalized.includes('planning') ||
    normalized.includes('planejamento') ||
    normalized.includes('modeling') ||
    normalized.includes('modelagem')
  ) {
    return 'planning';
  }

  // Completed as Study Exercise
  if (
    normalized.includes('exercise') ||
    normalized.includes('exercício') ||
    normalized.includes('exercicio') ||
    normalized.includes('study') ||
    normalized.includes('estudo')
  ) {
    return 'exercise';
  }

  return 'exercise';
};

const key = normalizeStatus(status);

const statusConfigs: Record<NormalizedStatus, StatusConfig> = {
  functional: {
    classes: 'bg-emerald-100 text-emerald-900 border-emerald-300 dark:bg-emerald-950/80 dark:text-emerald-200 dark:border-emerald-700/90',
    dotClasses: 'fill-emerald-600 dark:fill-emerald-400',
    pulseClasses: 'fill-emerald-400 dark:fill-emerald-500',
    labelEn: 'Functional / Near-Complete',
    labelPt: 'Funcional / Quase Concluído',
    ariaLabel: 'Project status: Functional / Near-Complete',
  },
  development: {
    classes: 'bg-amber-100 text-amber-950 border-amber-300 dark:bg-amber-950/80 dark:text-amber-200 dark:border-amber-700/90',
    dotClasses: 'fill-amber-600 dark:fill-amber-400',
    pulseClasses: 'fill-amber-400 dark:fill-amber-500',
    labelEn: 'In Development',
    labelPt: 'Em Desenvolvimento',
    ariaLabel: 'Project status: In Development',
  },
  planning: {
    classes: 'bg-indigo-100 text-indigo-950 border-indigo-300 dark:bg-indigo-950/80 dark:text-indigo-200 dark:border-indigo-700/90',
    dotClasses: 'fill-indigo-600 dark:fill-indigo-400',
    pulseClasses: 'fill-indigo-400 dark:fill-indigo-500',
    labelEn: 'Planning / Data Modeling Stage',
    labelPt: 'Planejamento / Modelagem de Dados',
    ariaLabel: 'Project status: Planning / Data Modeling Stage',
  },
  exercise: {
    classes: 'bg-slate-100 text-slate-800 border-slate-300 dark:bg-slate-800/90 dark:text-slate-200 dark:border-slate-600',
    dotClasses: 'fill-slate-500 dark:fill-slate-400',
    pulseClasses: 'fill-slate-400 dark:fill-slate-500',
    labelEn: 'Completed as Study Exercise',
    labelPt: 'Concluído como Exercício de Estudo',
    ariaLabel: 'Project status: Completed as Study Exercise',
  },
};

const config = statusConfigs[key];
const labelPt = customLabelPt || config.labelPt;
const labelEn = customLabelEn || config.labelEn;

const sizeClasses = size === 'sm'
  ? 'px-3 py-1 text-xs'
  : 'px-3.5 py-1.5 text-xs';
---

<span
  role="status"
  class:list={[
    'inline-flex items-center gap-2 rounded-full font-mono font-medium tracking-normal border shadow-xs transition-colors',
    config.classes,
    sizeClasses,
    className,
  ]}
>
  <svg class="w-2 h-2 flex-shrink-0" viewBox="0 0 8 8" aria-hidden="true">
    <circle cx="4" cy="4" r="3.5" class={config.dotClasses} />
  </svg>
  <span class="lang-pt font-semibold tracking-normal">{labelPt}</span>
  <span class="lang-en font-semibold tracking-normal">{labelEn}</span>
</span>
