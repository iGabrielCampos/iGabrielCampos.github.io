---
import { portfolioContent } from '../data/content';

const pt = portfolioContent['pt-BR'].about;
const en = portfolioContent['en'].about;
---

<section id="about" class="py-12 sm:py-16 border-b border-slate-200 dark:border-slate-800">
  <div class="space-y-3 mb-8">
    <div class="flex items-center gap-2">
      <span class="text-xs font-mono font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">
        06.
      </span>
      <h2 class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400">
        <span class="lang-pt">{pt.sectionTag}</span>
        <span class="lang-en">{en.sectionTag}</span>
      </h2>
    </div>

    <h3 class="text-2xl sm:text-3xl font-bold font-mono tracking-tight text-slate-900 dark:text-white">
      <span class="lang-pt">{pt.sectionTitle}</span>
      <span class="lang-en">{en.sectionTitle}</span>
    </h3>

    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl">
      <span class="lang-pt">{pt.sectionSubtitle}</span>
      <span class="lang-en">{en.sectionSubtitle}</span>
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Story / Backstory Paragraphs (2 cols on lg) -->
    <div class="lg:col-span-2 space-y-4 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
      {pt.paragraphs.map((para, index) => {
        const enPara = en.paragraphs[index] || para;
        return (
          <p>
            <span class="lang-pt">{para}</span>
            <span class="lang-en">{enPara}</span>
          </p>
        );
      })}
    </div>

    <!-- Quick Facts Box (1 col on lg) -->
    <div class="p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/40 h-fit space-y-4">
      <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white pb-3 border-b border-slate-200 dark:border-slate-800">
        <span class="lang-pt">{pt.quickFactsTitle}</span>
        <span class="lang-en">{en.quickFactsTitle}</span>
      </h4>

      <dl class="space-y-3.5 text-xs">
        {pt.quickFacts.map((fact, index) => {
          const enFact = en.quickFacts[index] || fact;
          return (
            <div>
              <dt class="font-mono text-slate-500 dark:text-slate-400 uppercase text-[10px] tracking-wider mb-0.5">
                <span class="lang-pt">{fact.label}</span>
                <span class="lang-en">{enFact.label}</span>
              </dt>
              <dd class="font-medium text-slate-900 dark:text-slate-200">
                <span class="lang-pt">{fact.value}</span>
                <span class="lang-en">{enFact.value}</span>
              </dd>
            </div>
          );
        })}
      </dl>
    </div>
  </div>
</section>
