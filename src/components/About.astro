---
import { portfolioContent } from '../data/content';

const pt = portfolioContent['pt-BR'].about;
const en = portfolioContent['en'].about;
---

<section id="about" class="py-12 sm:py-16 bg-[#f4f4ee] dark:bg-[#1a1a18] border-b border-[#e5e5dc] dark:border-[#282824]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-3 mb-8">
      <div class="flex items-center gap-2">
        <h2 class="text-xs font-mono uppercase tracking-widest text-amber-700 dark:text-amber-400">
          <span class="lang-pt">{pt.sectionTag}</span>
          <span class="lang-en">{en.sectionTag}</span>
        </h2>
      </div>

      <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-stone-900 dark:text-white">
        <span class="lang-pt">{pt.sectionTitle}</span>
        <span class="lang-en">{en.sectionTitle}</span>
      </h3>

      <p class="text-sm sm:text-base font-normal text-stone-600 dark:text-stone-400 max-w-prose leading-relaxed">
        <span class="lang-pt">{pt.sectionSubtitle}</span>
        <span class="lang-en">{en.sectionSubtitle}</span>
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Story / Backstory Paragraphs (2 cols on lg) -->
      <div class="lg:col-span-2 space-y-4 text-sm sm:text-base font-normal text-stone-700 dark:text-stone-300 leading-relaxed max-w-prose">
        {pt.paragraphs.map((para, index) => {
          const enPara = en.paragraphs[index] || para;
          return (
            <p>
              <span class="lang-pt">{para}</span>
              <span class="lang-en">{enPara}</span>
            </p>
          );
        })}
      </div>

      <!-- Quick Facts (Editorial Sidebar) -->
      <div class="h-fit space-y-4 pt-1 lg:pl-6 lg:border-l lg:border-[#e5e5dc] lg:dark:border-[#282824]">
        <h4 class="font-mono text-xs font-semibold uppercase tracking-wider text-stone-900 dark:text-white pb-3 border-b border-[#e5e5dc] dark:border-[#282824]">
          <span class="lang-pt">{pt.quickFactsTitle}</span>
          <span class="lang-en">{en.quickFactsTitle}</span>
        </h4>

        <dl class="space-y-3.5 text-xs">
          {pt.quickFacts.map((fact, index) => {
            const enFact = en.quickFacts[index] || fact;
            return (
              <div>
                <dt class="font-mono text-stone-600 dark:text-stone-400 uppercase text-xs tracking-wider mb-0.5">
                  <span class="lang-pt">{fact.label}</span>
                  <span class="lang-en">{enFact.label}</span>
                </dt>
                <dd class="font-medium text-stone-900 dark:text-stone-200">
                  <span class="lang-pt">{fact.value}</span>
                  <span class="lang-en">{enFact.value}</span>
                </dd>
              </div>
            );
          })}
        </dl>
      </div>
    </div>
  </div>
</section>
