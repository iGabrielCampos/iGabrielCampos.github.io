---
import { portfolioContent } from '../data/content';

const pt = portfolioContent['pt-BR'].about;
const en = portfolioContent['en'].about;
---

<section id="about" class="py-12 sm:py-16 bg-slate-100/60 dark:bg-[#1a1a18]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-3 mb-8">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">
        <span class="lang-pt">{pt.sectionTitle}</span>
        <span class="lang-en">{en.sectionTitle}</span>
      </h2>

      <p class="text-sm sm:text-base font-normal text-slate-600 dark:text-stone-400 max-w-prose leading-relaxed">
        <span class="lang-pt">{pt.sectionSubtitle}</span>
        <span class="lang-en">{en.sectionSubtitle}</span>
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Story / Backstory Paragraphs (2 cols on lg) -->
      <div class="lg:col-span-2 p-6 sm:p-7 rounded-xl bg-white dark:bg-[#1c1c1a] border border-slate-200/90 dark:border-[#2c2c28] shadow-xs space-y-4 text-sm sm:text-base font-normal text-slate-700 dark:text-stone-300 leading-relaxed">
        {pt.paragraphs.map((para, index) => {
          const enPara = en.paragraphs[index] || para;
          return (
            <p class="max-w-prose">
              <span class="lang-pt">{para}</span>
              <span class="lang-en">{enPara}</span>
            </p>
          );
        })}
      </div>

      <!-- Quick Facts (Editorial Card) -->
      <div class="h-fit p-6 rounded-xl bg-white dark:bg-[#1c1c1a] border border-slate-200/90 dark:border-[#2c2c28] shadow-xs space-y-4">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-[#282824]">
          <span class="lang-pt">{pt.quickFactsTitle}</span>
          <span class="lang-en">{en.quickFactsTitle}</span>
        </h3>

        <dl class="space-y-3.5 text-xs">
          {pt.quickFacts.map((fact, index) => {
            const enFact = en.quickFacts[index] || fact;
            return (
              <div>
                <dt class="font-mono text-slate-500 dark:text-stone-400 uppercase text-xs tracking-wider mb-0.5">
                  <span class="lang-pt">{fact.label}</span>
                  <span class="lang-en">{enFact.label}</span>
                </dt>
                <dd class="font-medium text-slate-900 dark:text-stone-200">
                  <span class="lang-pt">{fact.value}</span>
                  <span class="lang-en">{enFact.value}</span>
                </dd>
              </div>
            );
          })}
        </dl>
      </div>
    </div>
  </div>
</section>
