---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Gabriel Campos | Portfólio & Diário de Engenharia',
  description = 'Estudante de Análise e Desenvolvimento de Sistemas construindo em público com Python, Django e TypeScript. / Systems Analysis student building in public.',
  ogImage = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://igabrielcampos.github.io');
const socialImageURL = new URL(ogImage, canonicalURL);
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gabriel Campos" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="keywords" content="Gabriel Campos, Desenvolvedor Backend, ADS, Python, Django, TypeScript, Node.js, C, PostgreSQL, Portfólio, Diário de Engenharia, João Pessoa" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gabriel Campos — Portfólio & Diário de Engenharia" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Gabriel Campos — Portfólio & Diário de Engenharia" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://igabrielcampos.github.io/#person",
          "name": "Gabriel Campos",
          "jobTitle": "Desenvolvedor de Software",
          "description": "Estudante de Análise e Desenvolvimento de Sistemas com foco em Python, Django, TypeScript e Engenharia de Software.",
          "url": "https://igabrielcampos.github.io",
          "image": "https://igabrielcampos.github.io/og-image.png",
          "sameAs": [
            "https://github.com/iGabrielCampos",
            "https://www.linkedin.com/in/gabriel-campos-2604b2411/"
          ],
          "knowsAbout": [
            "Python",
            "Django",
            "Django REST Framework",
            "TypeScript",
            "Node.js",
            "C",
            "PostgreSQL",
            "SQLite",
            "REST APIs",
            "Engenharia de Software"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://igabrielcampos.github.io/#website",
          "url": "https://igabrielcampos.github.io",
          "name": "Gabriel Campos — Portfólio & Diário de Engenharia",
          "description": "Portfólio e diário de engenharia de Gabriel Campos. Projetos práticos, decisões de arquitetura e aprendizado contínuo.",
          "publisher": {
            "@id": "https://igabrielcampos.github.io/#person"
          },
          "inLanguage": ["pt-BR", "en"]
        },
        {
          "@type": "ProfilePage",
          "@id": "https://igabrielcampos.github.io/#profilepage",
          "url": "https://igabrielcampos.github.io",
          "name": "Gabriel Campos — Portfólio de Desenvolvedor",
          "mainEntity": {
            "@id": "https://igabrielcampos.github.io/#person"
          }
        }
      ]
    })} />

    <!-- Early Theme and Language Initialization Script (Prevents FOUC) -->
    <script is:inline>
      (function () {
        try {
          const storedTheme = localStorage.getItem('portfolio_theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = storedTheme ? storedTheme : prefersDark ? 'dark' : 'light';
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {
          console.error(e);
        }

        try {
          const storedLang = localStorage.getItem('portfolio_lang');
          const browserLang =
            navigator.language && navigator.language.toLowerCase().startsWith('pt')
              ? 'pt-BR'
              : 'en';
          const lang = storedLang ? storedLang : browserLang;
          document.documentElement.lang = lang;
          document.documentElement.setAttribute('lang', lang);
          document.documentElement.setAttribute('data-lang', lang);
        } catch (e) {
          console.error(e);
        }
      })();
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-[#141413] text-slate-900 dark:text-stone-100 min-h-screen flex flex-col font-sans transition-colors duration-200">
    <!-- Accessible Skip to Content Link -->
    <a href="#main-content" class="skip-to-content focus:outline-none focus:ring-2 focus:ring-sky-500 dark:focus:ring-amber-500">
      <span class="lang-pt">Pular para o conteúdo principal</span>
      <span class="lang-en">Skip to main content</span>
    </a>

    <!-- Sticky Header -->
    <header class="sticky top-0 z-40 w-full border-b border-slate-200/80 dark:border-[#2c2c28] bg-white/85 dark:bg-[#141413]/85 backdrop-blur-md transition-colors duration-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Site Logo / Branding -->
        <a
          href="/"
          class="flex items-center gap-2 text-slate-900 dark:text-white font-mono font-semibold text-sm tracking-tight hover:text-sky-600 dark:hover:text-amber-400 transition-colors"
          aria-label="Portfolio Home"
        >
          <span class="text-sky-600 dark:text-amber-400 font-bold">&gt;</span>
          <span>gabriel.campos</span>
        </a>

        <!-- Desktop Navigation -->
        <nav aria-label="Main Navigation" class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-stone-300">
          <a href="#principles" class="nav-link py-1 hover:text-slate-900 dark:hover:text-white transition-colors">
            <span class="lang-pt">Princípios</span>
            <span class="lang-en">Principles</span>
          </a>
          <a href="#projects" class="nav-link py-1 hover:text-slate-900 dark:hover:text-white transition-colors">
            <span class="lang-pt">Projetos</span>
            <span class="lang-en">Projects</span>
          </a>
          <a href="#journal" class="nav-link py-1 hover:text-slate-900 dark:hover:text-white transition-colors">
            <span class="lang-pt">Diário</span>
            <span class="lang-en">Journal</span>
          </a>
          <a href="#learning" class="nav-link py-1 hover:text-slate-900 dark:hover:text-white transition-colors">
            <span class="lang-pt">Estudos</span>
            <span class="lang-en">Learning</span>
          </a>
          <a href="#about" class="nav-link py-1 hover:text-slate-900 dark:hover:text-white transition-colors">
            <span class="lang-pt">Sobre</span>
            <span class="lang-en">About</span>
          </a>
          <a href="#contact" class="nav-link py-1 hover:text-slate-900 dark:hover:text-white transition-colors">
            <span class="lang-pt">Contato</span>
            <span class="lang-en">Contact</span>
          </a>
        </nav>

        <!-- Right Controls: Language & Theme Toggle -->
        <div class="flex items-center gap-2">
          <!-- Language Selector Button (Clean typographic PT / EN) -->
          <button
            id="lang-toggle"
            type="button"
            class="min-h-[44px] inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-xs font-mono font-medium border border-slate-200 dark:border-[#2c2c28] text-slate-700 dark:text-stone-300 hover:border-slate-300 dark:hover:border-stone-600 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:focus-visible:ring-amber-500"
            aria-label="Alternar idioma (Ativo: Português)"
            title="Alternar idioma / Toggle language"
          >
            <span class="lang-pill-pt font-bold text-slate-900 dark:text-white">PT</span>
            <span class="text-slate-300 dark:text-stone-600 select-none">/</span>
            <span class="lang-pill-en text-slate-400 dark:text-stone-500">EN</span>
          </button>

          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            class="w-11 h-11 min-h-[44px] min-w-[44px] inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-[#2c2c28] text-slate-700 dark:text-stone-300 hover:bg-slate-100 dark:hover:bg-[#1c1c1a] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:focus-visible:ring-amber-500"
            aria-label="Alternar tema claro/escuro / Toggle light/dark theme"
            title="Alternar tema / Toggle theme"
          >
            <!-- Sun icon for light mode toggle (shown in dark mode) -->
            <svg class="theme-icon-light hidden w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon icon for dark mode toggle (shown in light mode) -->
            <svg class="theme-icon-dark hidden w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <!-- Mobile Hamburger Button -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="md:hidden w-11 h-11 min-h-[44px] min-w-[44px] inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-[#2c2c28] text-slate-700 dark:text-stone-300 hover:bg-slate-100 dark:hover:bg-[#1c1c1a] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:focus-visible:ring-amber-500"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Abrir menu de navegação / Open navigation menu"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="18" x2="20" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Navigation -->
      <nav id="mobile-menu" class="hidden md:hidden border-t border-slate-200/80 dark:border-[#2c2c28] bg-white dark:bg-[#141413] px-4 py-3 space-y-1 text-sm font-medium">
        <a href="#principles" class="block py-3 text-slate-600 dark:text-stone-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <span class="lang-pt">Princípios</span>
          <span class="lang-en">Principles</span>
        </a>
        <a href="#projects" class="block py-3 text-slate-600 dark:text-stone-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <span class="lang-pt">Projetos</span>
          <span class="lang-en">Projects</span>
        </a>
        <a href="#journal" class="block py-3 text-slate-600 dark:text-stone-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <span class="lang-pt">Diário Técnico</span>
          <span class="lang-en">Technical Journal</span>
        </a>
        <a href="#learning" class="block py-3 text-slate-600 dark:text-stone-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <span class="lang-pt">Estudos Atuais</span>
          <span class="lang-en">Currently Learning</span>
        </a>
        <a href="#about" class="block py-3 text-slate-600 dark:text-stone-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <span class="lang-pt">Sobre</span>
          <span class="lang-en">About</span>
        </a>
        <a href="#contact" class="block py-3 text-slate-600 dark:text-stone-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <span class="lang-pt">Contato</span>
          <span class="lang-en">Contact</span>
        </a>
      </nav>
    </header>

    <!-- Main Content (Full-width to allow alternating section canvas bands) -->
    <main id="main-content" tabindex="-1" class="flex-grow w-full focus:outline-none">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="border-t border-slate-200/80 dark:border-[#2c2c28] bg-slate-100 dark:bg-[#10100f] text-xs text-slate-600 dark:text-stone-400 py-8 transition-colors duration-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="font-mono font-semibold text-slate-800 dark:text-stone-300">Gabriel Campos</span>
          <span class="mx-1.5">•</span>
          <span class="lang-pt">Portfólio e Diário de Engenharia Transparente</span>
          <span class="lang-en">Transparent Engineering Journal & Portfolio</span>
        </div>
        <div class="flex items-center gap-4 font-mono">
          <a
            href="https://github.com/iGabrielCampos"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-slate-900 dark:hover:text-stone-200 transition-colors inline-flex items-center gap-1"
            aria-label="GitHub Profile (abre em nova aba)"
          >
            <span>GitHub</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
          <a href="#main-content" class="hover:text-slate-900 dark:hover:text-stone-200 transition-colors inline-flex items-center gap-1">
            <span class="lang-pt">Voltar ao topo</span>
            <span class="lang-en">Back to top</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <!-- Interactive Client Script for Theme & Language Handling -->
    <script>
      function setupInteractions() {
        const themeBtn = document.getElementById('theme-toggle');
        const langBtn = document.getElementById('lang-toggle');
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        // Theme sync function
        function updateThemeIcons(isDark: boolean) {
          const lightIcons = document.querySelectorAll('.theme-icon-light');
          const darkIcons = document.querySelectorAll('.theme-icon-dark');
          lightIcons.forEach((el) => el.classList.toggle('hidden', !isDark));
          darkIcons.forEach((el) => el.classList.toggle('hidden', isDark));

          if (themeBtn) {
            const isPt = (document.documentElement.getAttribute('lang') || 'pt-BR').startsWith('pt');
            themeBtn.setAttribute(
              'aria-label',
              isDark
                ? (isPt ? 'Mudar para modo claro' : 'Switch to light theme')
                : (isPt ? 'Mudar para modo escuro' : 'Switch to dark theme')
            );
            themeBtn.setAttribute('aria-pressed', String(isDark));
          }
        }

        // Lang sync function
        function updateLangPills(lang: string) {
          const isPt = lang === 'pt-BR';
          const ptPills = document.querySelectorAll('.lang-pill-pt');
          const enPills = document.querySelectorAll('.lang-pill-en');

          ptPills.forEach((el) => {
            el.className = isPt
              ? 'lang-pill-pt font-bold text-slate-900 dark:text-white transition-colors'
              : 'lang-pill-pt text-slate-400 dark:text-stone-500 transition-colors';
          });
          enPills.forEach((el) => {
            el.className = !isPt
              ? 'lang-pill-en font-bold text-slate-900 dark:text-white transition-colors'
              : 'lang-pill-en text-slate-400 dark:text-stone-500 transition-colors';
          });

          if (langBtn) {
            langBtn.setAttribute('aria-label', isPt ? 'Mudar idioma para Inglês' : 'Switch language to Portuguese');
          }

          document.title = isPt
            ? 'Gabriel Campos | Portfólio & Diário de Engenharia'
            : 'Gabriel Campos | Portfolio & Engineering Journal';
        }

        // Initial UI sync
        const isDark = document.documentElement.classList.contains('dark');
        updateThemeIcons(isDark);
        updateLangPills(document.documentElement.lang || 'pt-BR');

        // Real-time OS theme change listener
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (!localStorage.getItem('portfolio_theme')) {
            document.documentElement.classList.toggle('dark', e.matches);
            updateThemeIcons(e.matches);
          }
        });

        // Theme Toggle Event
        if (themeBtn) {
          themeBtn.addEventListener('click', () => {
            const nextDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('portfolio_theme', nextDark ? 'dark' : 'light');
            updateThemeIcons(nextDark);
          });
        }

        // Language Toggle Event
        if (langBtn) {
          langBtn.addEventListener('click', () => {
            const currentLang = document.documentElement.getAttribute('lang') || document.documentElement.lang || 'pt-BR';
            const nextLang = currentLang.startsWith('pt') ? 'en' : 'pt-BR';
            document.documentElement.lang = nextLang;
            document.documentElement.setAttribute('lang', nextLang);
            document.documentElement.setAttribute('data-lang', nextLang);
            localStorage.setItem('portfolio_lang', nextLang);
            updateLangPills(nextLang);
          });
        }

        // Mobile Menu Event
        if (mobileMenuBtn && mobileMenu) {
          mobileMenuBtn.addEventListener('click', () => {
            const expanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
            mobileMenuBtn.setAttribute('aria-expanded', String(!expanded));
            mobileMenu.classList.toggle('hidden');
          });

          // Close mobile menu on link click
          mobileMenu.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
              mobileMenu.classList.add('hidden');
              mobileMenuBtn.setAttribute('aria-expanded', 'false');
            });
          });

          // Close on Escape key
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
              mobileMenu.classList.add('hidden');
              mobileMenuBtn.setAttribute('aria-expanded', 'false');
              mobileMenuBtn.focus();
            }
          });
        }

        // Active Scrollspy for Desktop Navigation
        const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
        const sectionIds = ['principles', 'projects', 'journal', 'learning', 'about', 'contact'];
        const sectionElements = sectionIds
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el !== null);

        function setActiveNav(id: string | null) {
          navLinks.forEach((link) => {
            const href = link.getAttribute('href');
            const isActive = id ? href === `#${id}` : false;
            link.classList.toggle('nav-link-active', isActive);
            if (isActive) {
              link.setAttribute('aria-current', 'true');
            } else {
              link.removeAttribute('aria-current');
            }
          });
        }

        if ('IntersectionObserver' in window && sectionElements.length > 0) {
          const visibleSections = new Map<string, number>();

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  visibleSections.set(entry.target.id, entry.intersectionRatio);
                } else {
                  visibleSections.delete(entry.target.id);
                }
              });

              if (window.scrollY < 150) {
                setActiveNav(null);
                return;
              }

              for (const id of sectionIds) {
                if (visibleSections.has(id)) {
                  setActiveNav(id);
                  break;
                }
              }
            },
            {
              root: null,
              rootMargin: '-15% 0px -60% 0px',
              threshold: [0, 0.2, 0.5],
            }
          );

          sectionElements.forEach((el) => observer.observe(el));

          window.addEventListener(
            'scroll',
            () => {
              if (window.scrollY < 150) {
                setActiveNav(null);
              } else if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 60) {
                setActiveNav('contact');
              }
            },
            { passive: true }
          );
        }
      }

      // Execute on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupInteractions);
      } else {
        setupInteractions();
      }
    </script>
  </body>
</html>
